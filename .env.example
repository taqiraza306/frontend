# Copy to .env and fill in:   cp .env.example .env
# Never commit .env (it is in .gitignore). Share credentials privately, not through git.

# ---- Amazon Bedrock (Claude) -------------------------------------------------
# These two lines are the setup the project was tested with.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
# The client is chosen from BEDROCK_BASE_URL:
#   https://bedrock-runtime.<region>.amazonaws.com      -> InvokeModel API (above)
#   https://bedrock-mantle.<region>.api.aws/anthropic   -> Messages API (default when unset;
#                                                          then use BEDROCK_MODEL_ID=anthropic.claude-sonnet-5)
# The region is taken from the URL unless AWS_REGION is set.
# AWS_REGION=us-east-1

# Authentication - use ONE of the following:
# 1) Bedrock API key
# AWS_BEARER_TOKEN_BEDROCK=
# 2) IAM access keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# 3) A named profile from ~/.aws/credentials or SSO
# AWS_PROFILE=default

# Reasoning effort: low | medium | high | xhigh | max
ANALYSIS_EFFORT=medium
QUERY_EFFORT=low

# ---- Embeddings (open source, runs locally) ----------------------------------
# Other good options: BAAI/bge-base-en-v1.5 (768-d, better), sentence-transformers/all-MiniLM-L6-v2
# Changing this automatically rebuilds the FAISS index on the next ingestion run.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: Hugging Face read token (removes the "unauthenticated requests" warning, higher rate limits)
# HF_TOKEN=hf_...
# Optional: never contact Hugging Face once the model is cached (faster startup)
# HF_HUB_OFFLINE=1

# ---- Paths & image limits -----------------------------------------------------
LIBRARY_DIR=library
STORAGE_DIR=storage
MAX_IMAGE_BLOCKS=12
MAX_IMAGE_EDGE=1920
